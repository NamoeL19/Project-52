; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A-Way"
config/version="0.0.1"
run/main_scene="uid://uprojybt0ism"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://mhd8svfnsmku"

[autoload]

GlobalConfigFile="*uid://c6oby3nnuccmu"
Dialogic="*uid://ds2q0uclmolvu"
Utils="*uid://x04367lgxdrq"

[dialogic]

directories/dch_directory={
"Charles": "res://Dialogic/Characters/Charles.dch"
}
directories/dtl_directory={
"Teste": "res://Dialogic/Timelines/Teste.dtl",
"fala2": "res://Dialogic/Timelines/fala2.dtl"
}
layout/style_directory={
"": "res://Dialogic/style/New_File.tres",
"New_File": "res://Dialogic/style/New_File.tres"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
translation/enabled=true
translation/original_locale=""
translation/file_mode=1
translation/translation_folder="res://assets/language/Dialogic_Translate"
translation/save_mode=0
translation/add_separator=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
translation/intern/save_mode=0
translation/intern/file_mode=1
translation/intern/translation_folder="res://assets/language"
translation/id_counter=18
translation/locales=[]
glossary/default_case_sensitive=true
layout/style_list=["res://Dialogic/style/New_File.tres"]
layout/default_style="res://Dialogic/style/New_File.tres"

[display]

window/size/viewport_width=496
window/size/viewport_height=496
window/stretch/mode="viewport"

[editor_plugins]

